{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "LabConstrictor_Demo",
  "menu_items": [
    {
      "name": "LabConstrictor_Demo",
      "description": "Launch LabConstrictor_Demo in its packaged JupyterLab environment.",
      "activate": true,
      "terminal": true,
      "working_dir": "{{ HOME }}",
      "command": [
        "{{ PYTHON }}",
        "{{ PREFIX }}/LabConstrictor_Demo/launch_jupyter.py",
        "{{ PREFIX }}/LabConstrictor_Demo/notebooks/Welcome.ipynb"
      ],
      "platforms": {
        "win": {
          "icon": "BASE_PATH_KEYWORD/LabConstrictor_Demo/logo.ico"
        },
        "linux": {
          "icon": "BASE_PATH_KEYWORD/LabConstrictor_Demo/logo.png"
        },
        "osx": {
          "icon": "BASE_PATH_KEYWORD/LabConstrictor_Demo/logo.icns"
        }
      }
    }
  ]
}
